---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent } from '../lib/content';

const content = getSiteContent();
---

<BaseLayout
  title="About"
  description={`${content.name} is a researcher working on AI governance and safety, with a background in law, fintech, and web3.`}
>
  <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 mb-8">
    About
  </h1>

  <div class="prose prose-neutral dark:prose-invert max-w-none" set:html={content.aboutHtml} />

  <div class="prose prose-neutral dark:prose-invert max-w-none mt-8">
    <h2>Education</h2>
    <ul>
      {content.education.map((edu) => (
        <li>
          <strong>{edu.degree}</strong>, {edu.school} ({edu.year})
          {edu.focus ? ` — ${edu.focus}` : ''}
          {edu.honors && (
            <span class="block text-sm text-neutral-500 dark:text-neutral-400">
              {edu.honors}
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
